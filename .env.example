NODE_ENV=production
PORT=10000
TZ=Asia/Kolkata
# Supabase Connect > Session pooler URI. URL-encode password characters.
DATABASE_URL=postgresql://postgres.PROJECT:YOUR_PASSWORD@POOLER_HOST:5432/postgres
# Optional Supabase root certificate PEM (TLS verification is always enabled).
DATABASE_CA=
APP_USERNAME=saif
# Set a unique password, at least 20 characters. Never commit it.
APP_PASSWORD=
APP_WORKSPACE=alishan

# Enable only after Google provider and callback are configured in Supabase.
APP_AUTH_MODE=
APP_ORIGIN=https://your-render-host.onrender.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Confirm which verified Supabase Auth user owns the existing workspace.
LEGACY_OWNER_USER_ID=
